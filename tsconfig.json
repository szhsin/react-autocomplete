{
  "compilerOptions": {
    "rootDir": "./src",
    "module": "nodenext",
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationDir": "./types/esm",
    "jsx": "react-jsx",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "target": "esnext",
    "lib": ["esnext", "dom"],
    "types": ["node", "vitest/globals", "@testing-library/jest-dom/vitest"]
  },
  "include": ["./src/"]
}
